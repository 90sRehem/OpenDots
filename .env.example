# OpenDots template: the UI opens in setup state until these fields are configured.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
# Keep OWNER_ID stable: it owns the persistent workspace and conversation state.
OWNER_ID=opendots-owner
# npm run dev allows http://localhost:5173 and http://127.0.0.1:5173.
# APP_ORIGIN replaces these defaults with comma-separated exact origins.
# Include scheme, hostname and port; omit paths and trailing slashes.
# APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Required for an external HOST binding (24+ characters); enables local login too.
# OWNER_TOKEN=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Optional local learning extractor: a loopback OpenAI-compatible endpoint only
# (http://127.0.0.1 or http://[::1], no credentials). Unset means automatic
# extraction is unavailable; manual authoring still works. It never falls back
# to OPENAI_BASE_URL.
# LEARNING_EXTRACTOR_URL=http://127.0.0.1:8080/v1
# LEARNING_EXTRACTOR_MODEL=
# Optional CLI-issued telemetry identity. Unset uses this installation's random ID.
# CPK_TELEMETRY_ID=
# SDK usage telemetry is enabled by default (separate from conversations).
# See docs/TELEMETRY.md for usage reporting and validation.
# Optional sampling override (default 1):
# COPILOTKIT_TELEMETRY_SAMPLE_RATE=1
# Either flag below opts out:
# COPILOTKIT_TELEMETRY_DISABLED=true
# DO_NOT_TRACK=1

# Optional isolated read-only public-page browser for WEB_SEARCH_PROVIDER=browser.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311
# Use the same random 24+ character secret in app/browser. All redirects are blocked.
# Supply canonical public URLs. Use the separate browser container for isolation.

# Optional realtime speech.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin

# Optional Telegram connector: the owner's private chat with a bot from @BotFather.
# See docs/SETUP.md#telegram. The token is a server-side secret: never logged, never sent to the browser.
TELEGRAM_BOT_TOKEN=
# The owner's numeric Telegram user id. Required with the token.
TELEGRAM_OWNER_ID=
# Optional extra numeric user ids, comma-separated.
TELEGRAM_ALLOWED_IDS=
# Optional existing Dot id; defaults to the first Dot.
TELEGRAM_DOT_ID=

# Optional persistent computers, one per Dot, using OpenBot services.
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and persistent volumes.
COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock

# Public-web search. Sample mode makes no calls.
# Self-hosted SearxNG (search only: result titles, snippets and URLs; pages are not fetched).
# Enable JSON in its settings.yml: search: formats: [html, json]. Keep it on loopback or a private host.
# SEARXNG_URL=http://127.0.0.1:8080
# Optional Exa search, a third-party provider used only when WEB_SEARCH_PROVIDER=exa is set explicitly.
# Queries are sent to Exa (api.exa.ai) with this key. It is never selected by default.
# EXA_API_KEY=
# Provider: searxng (needs SEARXNG_URL), exa (needs EXA_API_KEY), browser (URL-only page reader), or disabled.
# Unset selects searxng when SEARXNG_URL is set, browser when BROWSER_URL and BROWSER_SECRET are set, and disabled otherwise. Exa is never chosen automatically.
WEB_SEARCH_PROVIDER=
